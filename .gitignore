# =====================================================
# SISTEMA DE TUTORÍAS UNIVERSITARIAS - .gitignore
# =====================================================

# IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties

# Node / Next.js
node_modules/
.next/
out/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
coverage/
.vercel

# Docker
docker-compose.override.yml
.env
.env.local
.env.*.local

# Sistema Operativo
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Base de datos local
*.db
*.sqlite

# Archivos de configuración sensibles
application-local.properties
application-dev.properties

# Otros
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar