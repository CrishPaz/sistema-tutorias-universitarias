# Copia este archivo a .env y define tus valores. .env NO se versiona.
# docker compose lo carga automáticamente.

# Secreto para firmar los JWT (HS256 requiere >= 32 bytes tras decodificar base64url).
# Genera uno fuerte, p. ej.:  openssl rand -base64 48 | tr '+/' '-_'
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-0123456789abcdef
